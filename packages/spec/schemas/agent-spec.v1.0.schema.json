{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "webhook"
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        "approval_notifier": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "slack"
            },
            "token": {
              "type": "string",
              "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$"
            },
            "channel": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["type", "token", "channel"],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["anthropic", "openai", "ollama", "openrouter"]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "api_key": {
              "type": "string",
              "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$"
            },
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "timeout_ms": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["provider", "name"],
          "additionalProperties": false
        },
        "knowledge_base": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["pdf", "url", "text"]
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "source"],
            "additionalProperties": false
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "type": "string",
                    "const": "http_request"
                  },
                  "method": {
                    "type": "string",
                    "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "query": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "json": {
                            "anyOf": [
                              {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string"
                                },
                                "additionalProperties": {}
                              },
                              {
                                "type": "array",
                                "items": {}
                              }
                            ]
                          }
                        },
                        "required": ["json"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "form": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        },
                        "required": ["form"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "raw": {
                            "type": "string"
                          },
                          "content_type": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": ["raw"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "response": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": ["json", "text", "bytes"]
                      }
                    },
                    "required": ["mode"],
                    "additionalProperties": false
                  },
                  "failure_when": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "^(?:[A-Za-z0-9_$-]+|\\[\"(?:[^\"\\\\]|\\\\.)*\"\\]|\\[\\d+\\])(?:\\.[A-Za-z0-9_$-]+|\\[\"(?:[^\"\\\\]|\\\\.)*\"\\]|\\[\\d+\\])*$"
                        },
                        "exists": {
                          "type": "boolean"
                        },
                        "equals": {
                          "type": ["string", "number", "boolean", "null"]
                        },
                        "matches": {
                          "type": "string"
                        },
                        "message_path": {
                          "type": "string",
                          "pattern": "^(?:[A-Za-z0-9_$-]+|\\[\"(?:[^\"\\\\]|\\\\.)*\"\\]|\\[\\d+\\])(?:\\.[A-Za-z0-9_$-]+|\\[\"(?:[^\"\\\\]|\\\\.)*\"\\]|\\[\\d+\\])*$"
                        },
                        "retryable": {
                          "type": "boolean"
                        }
                      },
                      "required": ["path"],
                      "additionalProperties": false
                    }
                  },
                  "pace": {
                    "type": "object",
                    "properties": {
                      "rps": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1000
                      }
                    },
                    "required": ["rps"],
                    "additionalProperties": false
                  },
                  "retry": {
                    "type": "object",
                    "properties": {
                      "max": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "backoff": {
                        "type": "string",
                        "enum": ["fixed", "exponential"]
                      },
                      "base_ms": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "max_delay_ms": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["max"],
                    "additionalProperties": false
                  },
                  "requires_approval": {
                    "type": "boolean"
                  },
                  "extract": {
                    "type": "string"
                  }
                },
                "required": ["name", "action", "method", "url"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "type": "string",
                    "const": "component"
                  },
                  "use": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*@\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
                  },
                  "op": {
                    "type": "string",
                    "minLength": 1
                  },
                  "with": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "config": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "secrets": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$"
                    }
                  },
                  "requires_approval": {
                    "type": "boolean"
                  },
                  "extract": {
                    "type": "string"
                  }
                },
                "required": ["name", "action", "use", "op"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "type": "string",
                    "const": "slack_post_message"
                  },
                  "token": {
                    "type": "string",
                    "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$"
                  },
                  "channel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requires_approval": {
                    "type": "boolean"
                  },
                  "extract": {
                    "type": "string"
                  }
                },
                "required": ["name", "action", "token", "channel", "text"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "type": "string",
                    "const": "gmail_send"
                  },
                  "token": {
                    "type": "string",
                    "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$"
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requires_approval": {
                    "type": "boolean"
                  },
                  "extract": {
                    "type": "string"
                  }
                },
                "required": ["name", "action", "token", "to", "subject", "body"],
                "additionalProperties": false
              }
            ]
          }
        },
        "guardrails": {
          "type": "object",
          "properties": {
            "confidence_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fallback_action": {
              "type": "string",
              "enum": ["escalate_to_human"]
            }
          },
          "additionalProperties": false
        },
        "workflow": {
          "minItems": 1,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "const": "condition"
                  },
                  "if": {
                    "type": "string",
                    "minLength": 1
                  },
                  "then": {
                    "type": "string",
                    "minLength": 1
                  },
                  "else": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["step", "type", "if", "then", "else"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "const": "tool"
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["step", "type", "tool"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "const": "approval"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": ["step", "type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "inputs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "query": {
                    "type": "string"
                  },
                  "confidence_gate": {
                    "type": "boolean"
                  }
                },
                "required": ["step", "action"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["id", "name", "role", "goal", "workflow"],
      "additionalProperties": false
    }
  },
  "required": ["version", "agent"],
  "additionalProperties": false
}
