{
  "name": "kampong-agents",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Dev-first, canvas-code-duality agent workflow builder (local-first, TypeScript/Mastra).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=apps/canvas",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "vitest run --project unit --project unit-web",
    "test:integration": "vitest run --project integration --project integration-db",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:browser": "playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "prepare": "husky",
    "pack:release": "npm run build && node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.9.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
