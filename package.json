{
  "name": "kampong-agents",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Dev-first, canvas-code-duality agent workflow builder (local-first, TypeScript/Mastra).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=apps/canvas",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "vitest run --project unit --project unit-web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test": "npm run test:unit && npm run test:integration",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
