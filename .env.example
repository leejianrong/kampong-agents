# Copy to .env (gitignored). Read two ways: sourced into your shell for a
# local (non-Docker) `kampong run`/`kampong dev`, and read automatically by
# `docker compose` for both its own ${VAR} substitution and the app
# container's runtime environment (see docker-compose.yml's `env_file`) --
# one file, both purposes, no drift between them.

# BYOK secrets. A spec never contains a literal key -- only a ${ENV_VAR}
# placeholder (packages/spec's `model.api_key`, PLAN.md "Secrets", ADR-0009).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# examples/agent.yaml's default model provider (get a key at
# openrouter.ai/keys) -- required unless you switch that spec to the
# commented-out fully-offline Ollama block instead.
OPENROUTER_API_KEY=

# Demo connectors (examples/support-triage-demo.yaml). Same rule: a spec holds
# only the ${ENV_VAR} name, never the value.
# Slack bot token (xoxb-...) with the chat:write scope; invite the bot to the
# channel first (/invite @your-bot).
SLACK_BOT_TOKEN=
# Channel the demo posts to, e.g. #support-triage (or its channel ID).
SLACK_CHANNEL=
# Only for Approve/Reject buttons on a headless `kampong serve` run: the Slack
# app's signing secret (Basic Information > App Credentials). Not needed for
# the canvas, where approval is the in-app modal.
SLACK_SIGNING_SECRET=

# Docker stack only, below this line -----------------------------------

# The only port this stack binds on your machine -- change it here if it
# collides with another project's dev stack.
HOST_PORT=4310

# Spec filename `kampong dev` looks for inside ./workspace.
SPEC_FILENAME=agent.yaml
