# Real OpenRouter key (BYOK) -- required, used by every agent below. All
# model calls in every mastra-projects demo go through OpenRouter, never a
# direct ANTHROPIC_API_KEY (standing preference, not specific to this demo).
OPENROUTER_API_KEY=

# Which OpenRouter model to use. Defaults to openai/gpt-4o-mini if unset.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Real GitHub token with repo scope -- used for both reading PR diffs and
# posting review comments on the real sandbox repo. `gh auth token` works if
# you're already logged in via the gh CLI; a fine-grained PAT scoped to just
# the sandbox repo is preferred for anything beyond this one-off demo.
GITHUB_TOKEN=

# The real secret configured on the GitHub webhook (Settings -> Webhooks ->
# this webhook -> Secret). Used to verify X-Hub-Signature-256 on every
# incoming delivery -- never skip this check even for a throwaway repo.
# A real webhook already exists on the sandbox repo (see README.md) -- ask
# whoever set it up for its secret rather than generating a new one, unless
# you're registering a fresh webhook of your own.
GITHUB_WEBHOOK_SECRET=

# owner/repo of the real sandbox target repo.
SANDBOX_REPO=leejianrong/kampong-pr-review-sandbox

# Local port the webhook receiver listens on.
PORT=8787

# The real smee.io channel GitHub's webhook is configured to deliver to.
# `npm run forward` relays it to http://localhost:$PORT/webhook -- GitHub
# needs a public HTTPS URL to reach a local machine, and smee.io is the real
# (not mocked) tunnel for that during local development. See README.md.
SMEE_URL=https://smee.io/DPeQF0VcocXaox3w
