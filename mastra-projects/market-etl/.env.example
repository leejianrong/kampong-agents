# Real OpenRouter key (BYOK) -- required. Every model call in every
# mastra-projects demo goes through OpenRouter, never a direct
# ANTHROPIC_API_KEY (standing preference, not specific to this demo).
OPENROUTER_API_KEY=

# Which OpenRouter model to use. Defaults to openai/gpt-4o-mini if unset.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Real, free Alpha Vantage API key -- get one instantly, no verification,
# at https://www.alphavantage.co/support/#api-key. Free tier is rate
# limited to 25 requests/day and 5/minute; the default 3 tickers x
# RUN_INTERVAL_MS keeps this demo comfortably under that.
ALPHA_VANTAGE_API_KEY=

# Comma-separated real tickers to pull. Defaults to AAPL,MSFT,NVDA if unset.
TICKERS=AAPL,MSFT,NVDA

# Real Supabase project storing price observations + flagged anomalies.
SUPABASE_URL=https://hiygwuvnbzebbvyumhym.supabase.co

# The project's real service_role key (Project Settings -> API -> Project
# API keys) -- never the anon/publishable key. RLS is enabled with no
# policies on both tables, so only this key can read/write them at all.
SUPABASE_SERVICE_ROLE_KEY=

# Real Slack bot token (chat:write scope) and the real channel anomaly
# alerts are posted to. No signing secret/Interactivity needed here --
# this demo never waits on a human decision (SLICES.md V5: fully
# autonomous, no-HITL).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Below this absolute percent change between consecutive trading days, a
# move is not flagged. Deliberately sensitive by default so the demo
# reliably produces a real anomaly (SLICES.md: "a deliberately sensitive
# threshold for the demo").
ANOMALY_THRESHOLD_PERCENT=1.5

# How often the real scheduled job runs, in milliseconds. Defaults to
# every 6 hours. Use the dashboard's "Run now" button (POST /run) for an
# on-demand real run instead of waiting.
RUN_INTERVAL_MS=21600000

# Local port this server listens on.
PORT=8791
