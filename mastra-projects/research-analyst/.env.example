# Real OpenRouter key (BYOK) -- required. Every model call in every
# mastra-projects demo goes through OpenRouter, never a direct
# ANTHROPIC_API_KEY (standing preference, not specific to this demo).
OPENROUTER_API_KEY=

# Which OpenRouter model to use. Defaults to openai/gpt-4o-mini if unset.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Real Supabase project (pgvector enabled) storing the ingested document
# chunks and their embeddings. Project URL from Project Settings -> API.
SUPABASE_URL=https://cpirnzdlrhrvsuzqmbxt.supabase.co

# The project's real service_role key (Project Settings -> API -> Project
# API keys) -- never the anon/publishable key. This process is the only
# consumer and always runs server-side; RLS is enabled with no policies on
# both tables, so only the service_role key can read/write them at all.
SUPABASE_SERVICE_ROLE_KEY=

# Local port this server listens on.
PORT=8790
