{
  "name": "support-triage",
  "version": "0.1.0",
  "private": true,
  "description": "Real Gmail inbox triage: classify, draft, and escalate low-confidence tickets to Slack for approval, built directly on Mastra (kampong-agents mastra-projects Slice 3).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "forward:slack": "smee -u \"$SMEE_SLACK_URL\" -t http://localhost:${PORT:-8789}/slack/interactions",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.57",
    "@fastify/static": "^10.1.4",
    "@mastra/core": "1.64.0",
    "ai": "7.0.91",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.4",
    "nodemailer": "^7.0.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^7.0.4",
    "smee-client": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
