# Real OpenRouter key (BYOK) -- required. Every model call in every
# mastra-projects demo goes through OpenRouter, never a direct
# ANTHROPIC_API_KEY (standing preference, not specific to this demo).
OPENROUTER_API_KEY=

# Which OpenRouter model to use. Defaults to openai/gpt-4o-mini if unset.
OPENROUTER_MODEL=openai/gpt-4o-mini

# The real, dedicated Gmail inbox this demo polls -- NOT your personal
# account (ADR-0003: commingling test tickets with real personal mail is
# exactly what a dedicated inbox avoids).
IMAP_USER=

# A real Gmail App Password for that account (Google Account ->
# Security -> 2-Step Verification -> App passwords; requires 2-Step
# Verification to be turned on first). Not your normal Google password --
# Gmail rejects plain-password IMAP login for any account with 2FA on,
# and even without 2FA, an App Password is the safer real credential to
# put in a local .env.
IMAP_APP_PASSWORD=

# Only change these if you're not using Gmail's real IMAP endpoint.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# How often to poll the real inbox, in milliseconds.
POLL_INTERVAL_MS=30000

# Below this classifier confidence (0-1), a ticket is escalated to Slack
# for a real human decision instead of auto-drafted.
CONFIDENCE_THRESHOLD=0.7

# Real Slack bot token (chat:write scope) and the real channel to post
# escalations to. Reusing the same app already used for
# incident-responder/kampong-agents' own KAN-1432 testing works for
# posting, but see that demo's README about its single shared
# Interactivity Request URL if you need both running at once.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Real Slack app signing secret, used to verify inbound interaction
# (Approve/Reject button click) callbacks. From your Slack app's
# Basic Information page.
SLACK_SIGNING_SECRET=

# Real smee.io channel relaying Slack's interactivity callback (button
# clicks) to this process -- Slack requires a public HTTPS Request URL.
# Point your Slack app's Interactivity Request URL at this same channel.
SMEE_SLACK_URL=

# Local port this server listens on.
PORT=8789
