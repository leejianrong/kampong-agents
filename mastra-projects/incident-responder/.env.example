# Real OpenRouter key (BYOK) -- required. Every model call in every
# mastra-projects demo goes through OpenRouter, never a direct
# ANTHROPIC_API_KEY (standing preference, not specific to this demo).
OPENROUTER_API_KEY=

# Which OpenRouter model to use. Defaults to openai/gpt-4o-mini if unset.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Real Slack bot token (chat:write scope) and the real channel to post
# incident proposals to.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Real Slack app signing secret, used to verify inbound interaction
# (Approve/Reject button click) callbacks. From your Slack app's
# Basic Information page.
SLACK_SIGNING_SECRET=

# Must match alertmanager/alertmanager.yml's http_config.authorization.credentials
# exactly -- this is a real (if purely local) bearer-token check on the
# inbound Alertmanager webhook. A pre-generated value is already in that
# file; keep both in sync if you change it.
ALERTMANAGER_WEBHOOK_TOKEN=5df9f49d22deb682abade28f42a9a0a8fe3dc112

# Where the real toy service is reachable from this process (not from
# inside the docker-compose network -- see docker-compose.yml's port mapping).
TOY_SERVICE_URL=http://localhost:9100

# Local port this server listens on. alertmanager.yml's webhook URL assumes
# 8788 via host.docker.internal -- change both together if you change this.
PORT=8788

# Real smee.io channel relaying Slack's interactivity callback (button
# clicks) to this process. Slack requires a public HTTPS Request URL --
# unlike the Alertmanager webhook, this one really does need a tunnel.
# Set your Slack app's Interactivity Request URL to this same channel.
SMEE_SLACK_URL=https://smee.io/dhHOikbYFht2jlnW
